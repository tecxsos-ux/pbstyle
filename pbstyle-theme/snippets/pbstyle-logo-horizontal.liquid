<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 500 120" class="{{ class | default: 'w-full h-full' }}">
  <defs>
    <style>
      .logo-mark { font-family: 'Bodoni Moda', serif; fill: currentColor; }
      .logo-text { font-family: 'Bodoni Moda', serif; fill: currentColor; letter-spacing: 0.12em; }
      .logo-frame { fill: none; stroke: currentColor; stroke-width: 1.5; }
    </style>
  </defs>

  <!-- Circular Emblem -->
  <circle cx="60" cy="60" r="50" class="logo-frame" />
  <circle cx="60" cy="60" r="44" class="logo-frame" stroke-width="0.5" />
  
  <text x="48" y="88" class="logo-mark" font-size="80" font-weight="400" text-anchor="middle">P</text>
  <text x="75" y="88" class="logo-mark" font-size="80" font-weight="400" text-anchor="middle">B</text>

  <!-- Brand Name -->
  <text x="140" y="80" class="logo-text" font-size="52" font-weight="400" text-anchor="start">PBSTYLE</text>
</svg>
