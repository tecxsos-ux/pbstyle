{% comment %}
  This section is used in the page template to render store pages like About us
  or Contact us.
{% endcomment %}

<main class="pt-32 pb-section-padding bg-surface min-h-screen">
  <div class="max-w-3xl mx-auto px-margin-desktop">
    <h1 class="font-display-lg text-display-lg mb-12 text-center text-on-surface">{{ page.title }}</h1>
    
    <div class="font-body-lg text-body-lg text-on-surface-variant leading-relaxed space-y-6 prose prose-lg">
      {{ page.content }}
    </div>
  </div>
</main>

{% schema %}
{
  "name": "PBStyle Generic Page",
  "settings": []
}
{% endschema %}
