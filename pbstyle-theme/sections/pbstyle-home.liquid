<!-- Latest Acquisitions Slideshow -->
<section class="py-section-padding bg-surface border-y border-outline-variant/20 overflow-hidden relative">
  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mb-16">
    <div class="flex justify-between items-end">
      <div class="space-y-4">
        <span class="font-label-sm text-label-sm uppercase text-primary tracking-[0.2em]">Neuheiten</span>
        <h2 class="font-display-lg text-display-lg-mobile md:text-headline-lg text-on-surface">Die neuesten Objekte</h2>
      </div>
      <div class="hidden md:flex gap-4">
        <button id="slide-left" class="w-14 h-14 rounded-full border border-outline/30 flex items-center justify-center hover:bg-surface-container-high hover:text-primary transition-all duration-300"><span class="material-symbols-outlined">chevron_left</span></button>
        <button id="slide-right" class="w-14 h-14 rounded-full border border-outline/30 flex items-center justify-center hover:bg-surface-container-high hover:text-primary transition-all duration-300"><span class="material-symbols-outlined">chevron_right</span></button>
      </div>
    </div>
  </div>

  <div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop">
    <div id="product-slider" class="flex gap-8 overflow-x-auto snap-x snap-mandatory pb-12 no-scrollbar scroll-smooth">
      {% assign product_count = 0 %}
      {% for product in collections.all.products limit: 5 %}
        {% assign product_count = product_count | plus: 1 %}
        <a href="{{ product.url }}" class="group w-[290px] md:w-[calc((100%-64px)/3)] snap-center flex-shrink-0 cursor-pointer block">
          <!-- Fine Matted Frame -->
          <div class="p-4 bg-surface-container-lowest border border-outline-variant/30 shadow-lg group-hover:shadow-2xl transition-all duration-500">
            <div class="relative aspect-[4/5] overflow-hidden border border-outline-variant/10 bg-surface-container-low">
              <img src="{{ product.featured_image | img_url: '600x' }}" alt="{{ product.title | escape }}" class="w-full h-full object-cover transition-transform duration-[1200ms] group-hover:scale-105">
              <!-- Double border matting -->
              <div class="absolute inset-4 border border-outline-variant/20 z-10 pointer-events-none"></div>
              <div class="absolute inset-5 border border-white/5 z-10 pointer-events-none"></div>
            </div>
            <div class="pt-6 pb-2 text-center">
              <h3 class="font-headline-md text-headline-md mb-2 text-on-surface group-hover:text-primary transition-colors duration-300 truncate px-4">{{ product.title }}</h3>
              <p class="font-body-md text-primary tracking-widest font-light">{{ product.price | money }}</p>
            </div>
          </div>
        </a>
      {% endfor %}

      {% if product_count == 0 %}
        {% for i in (1..5) %}
        <div class="group w-[290px] md:w-[calc((100%-64px)/3)] snap-center flex-shrink-0 cursor-pointer block">
          <div class="p-4 bg-surface-container-lowest border border-outline-variant/30 shadow-lg group-hover:shadow-2xl transition-all duration-500">
            <div class="relative aspect-[4/5] overflow-hidden border border-outline-variant/10 bg-surface-container-highest flex items-center justify-center">
              <span class="material-symbols-outlined text-4xl text-outline-variant">diamond</span>
              <div class="absolute inset-4 border border-outline-variant/20 z-10 pointer-events-none"></div>
            </div>
            <div class="pt-6 pb-2 text-center">
              <h3 class="font-headline-md text-headline-md mb-2 text-on-surface truncate px-4">New Object {{ i }}</h3>
              <p class="font-body-md text-primary tracking-widest font-light">$0.00</p>
            </div>
          </div>
        </div>
        {% endfor %}
      {% endif %}
    </div>
  </div>

  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // 1. Shuffle/select random hero images
      const imagesJson = document.getElementById('hero-images-data');
      const heroImage1 = document.getElementById('hero-image-1');
      const heroImage2 = document.getElementById('hero-image-2');
      
      if (imagesJson && heroImage1 && heroImage2) {
        try {
          const images = JSON.parse(imagesJson.textContent).filter(img => img && img !== "");
          if (images.length >= 1) {
            // Pick random index 1
            const index1 = Math.floor(Math.random() * images.length);
            heroImage1.src = images[index1];
            
            // Pick random index 2
            if (images.length > 1) {
              let index2 = Math.floor(Math.random() * images.length);
              while (index2 === index1) {
                index2 = Math.floor(Math.random() * images.length);
              }
              heroImage2.src = images[index2];
            }
          }
        } catch (e) {
          console.error("Error setting random hero images:", e);
        }
      }

      // 2. Slideshow scrolling logic
      const slider = document.getElementById('product-slider');
      const leftBtn = document.getElementById('slide-left');
      const rightBtn = document.getElementById('slide-right');
      
      let autoPlayInterval;

      function getSlideAmount() {
        if (slider && slider.firstElementChild) {
          return slider.firstElementChild.clientWidth + 32; // item width + gap
        }
        return 380;
      }

      function startAutoPlay() {
        autoPlayInterval = setInterval(() => {
          if (slider) {
            const slideAmount = getSlideAmount();
            if (slider.scrollLeft + slider.clientWidth >= slider.scrollWidth - 10) {
              slider.scrollTo({ left: 0, behavior: 'smooth' });
            } else {
              slider.scrollBy({ left: slideAmount, behavior: 'smooth' });
            }
          }
        }, 4000);
      }

      function stopAutoPlay() {
        clearInterval(autoPlayInterval);
      }

      if(slider) {
        startAutoPlay();
        slider.addEventListener('mouseenter', stopAutoPlay);
        slider.addEventListener('mouseleave', startAutoPlay);
      }

      if(leftBtn && rightBtn && slider) {
        leftBtn.addEventListener('click', () => {
          slider.scrollBy({ left: -getSlideAmount(), behavior: 'smooth' });
          stopAutoPlay();
          startAutoPlay();
        });
        rightBtn.addEventListener('click', () => {
          slider.scrollBy({ left: getSlideAmount(), behavior: 'smooth' });
          stopAutoPlay();
          startAutoPlay();
        });
      }
    });
  </script>
</section>

