{% assign image_urls = "" %}
{% for product in collections.all.products %}
  {% if product.featured_image %}
    {% if image_urls == "" %}
      {% assign image_urls = product.featured_image | img_url: '1200x' %}
    {% else %}
      {% assign current_img_url = product.featured_image | img_url: '1200x' %}
      {% assign image_urls = image_urls | append: ":::" | append: current_img_url %}
    {% endif %}
  {% endif %}
{% endfor %}
{% assign image_array = image_urls | split: ":::" %}

<script id="hero-images-data" type="application/json">
  {{ image_array | json }}
</script>

