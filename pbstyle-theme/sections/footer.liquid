<footer class="bg-surface-container-lowest border-t border-outline-variant/30 w-full pt-section-padding pb-gutter">
<div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop flex flex-col md:flex-row justify-between items-start gap-gutter">
<div class="max-w-xs">
<div class="text-[#8B5A45] h-12 md:h-16 mb-8 block w-auto">
{% render 'pbstyle-logo-horizontal', class: 'h-full w-auto' %}
</div>
<p class="font-body-md text-on-surface-variant mb-8">
    Die Verbindung von industrieller Präzision und High-Fashion-Ästhetik seit 2024.
</p>
<div class="flex gap-6">
<a class="material-symbols-outlined text-on-surface-variant hover:text-primary" href="#">public</a>
<a class="material-symbols-outlined text-on-surface-variant hover:text-primary" href="#">camera</a>
<a class="material-symbols-outlined text-on-surface-variant hover:text-primary" href="#">mail</a>
</div>
</div>
<div class="grid grid-cols-2 md:grid-cols-3 gap-12 md:gap-24">
<div class="flex flex-col gap-4">
<span class="font-label-md uppercase tracking-widest text-primary mb-2">Shop</span>
<a class="font-body-md text-on-surface-variant hover:text-primary transition-all" href="#">Schmuck</a>
<a class="font-body-md text-on-surface-variant hover:text-primary transition-all" href="#">Beauty-Tools</a>
<a class="font-body-md text-on-surface-variant hover:text-primary transition-all" href="#">Geschenkkarten</a>
</div>
<div class="flex flex-col gap-4">
<span class="font-label-md uppercase tracking-widest text-primary mb-2">Support</span>
<a class="font-body-md text-on-surface-variant hover:underline decoration-primary/30 underline-offset-4" href="#">Versand</a>
<a class="font-body-md text-on-surface-variant hover:underline decoration-primary/30 underline-offset-4" href="#">Rückgabe</a>
<a class="font-body-md text-on-surface-variant hover:underline decoration-primary/30 underline-offset-4" href="#">Datenschutzerklärung</a>
</div>
<div class="flex flex-col gap-4">
<span class="font-label-md uppercase tracking-widest text-primary mb-2">Marke</span>
<a class="font-body-md text-on-surface-variant hover:underline decoration-primary/30 underline-offset-4" href="#">Nachhaltigkeit</a>
<a class="font-body-md text-on-surface-variant hover:underline decoration-primary/30 underline-offset-4" href="#">Handwerkskunst</a>
<a class="font-body-md text-on-surface-variant hover:underline decoration-primary/30 underline-offset-4" href="#">Journal</a>
</div>
</div>
</div>
<div class="max-w-container-max mx-auto px-margin-mobile md:px-margin-desktop mt-section-padding pt-8 border-t border-outline-variant/10 flex flex-col md:flex-row justify-between items-center gap-6">
  <p class="font-label-sm text-on-surface-variant opacity-60">© {{ 'now' | date: '%Y' }} PBSTYLE Industrielle Eleganz. Alle Rechte vorbehalten.</p>
  
  <!-- Payment Support Badges -->
  <div class="flex items-center gap-4 text-on-surface-variant">
    <!-- TWINT Badge -->
    <div class="h-8 px-3 flex items-center justify-center border border-outline-variant/20 rounded bg-surface-container-low hover:border-primary transition-colors cursor-default select-none" title="TWINT">
      <svg class="h-4 w-auto" viewBox="0 0 76 20" fill="none" xmlns="http://www.w3.org/2000/svg">
        <path d="M11.6 3C11.6 1.34315 12.9431 0 14.6 0H61.4C63.0569 0 64.4 1.34315 64.4 3V17C64.4 18.6569 63.0569 20 61.4 20H14.6C12.9431 20 11.6 18.6569 11.6 17V3Z" fill="#1F1F1F" class="dark:fill-white"/>
        <circle cx="21" cy="10" r="4" fill="#00B050"/>
        <path d="M30 6H33V14H30V6ZM36 6H38L40 11L42 6H44V14H42V9L40.2 13H39.8L38 9V14H36V6ZM47 6H50V14H47V6Z" fill="#FFFFFF" class="dark:fill-[#121212]"/>
      </svg>
      <span class="font-label-sm text-xs font-semibold uppercase tracking-wider text-[#00B050] ml-1.5">TWINT</span>
    </div>
    <!-- Visa -->
    <div class="h-8 w-12 flex items-center justify-center border border-outline-variant/20 rounded bg-surface-container-low hover:border-primary transition-colors cursor-default select-none" title="Visa">
      <svg class="h-4 w-auto text-on-surface" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <path d="M17.472 15.6l1.32-8.16h-2.112l-1.32 8.16h2.112zm-3.488-8.16h-2.208c-.624 0-1.056.24-1.344.864l-3.36 7.296h2.208l.432-1.2h2.736l.24 1.2h1.92l-1.624-8.16zm-3.792 5.04c.144-.432.72-2.112.72-2.112s.144-.384.24-.624l.144.72.48 2.016h-1.584zm-3.504-5.04L3.84 13.92c-.144.384-.576.816-1.152.816H1.2v.336h4.32c.576 0 .96-.336 1.152-.816l2.112-5.424-2.112-.672zm13.104 0h-1.92l-2.736 8.16h1.92l2.736-8.16z"/>
      </svg>
    </div>
    <!-- Mastercard -->
    <div class="h-8 w-12 flex items-center justify-center border border-outline-variant/20 rounded bg-surface-container-low hover:border-primary transition-colors cursor-default select-none" title="Mastercard">
      <svg class="h-5 w-auto text-on-surface" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
        <circle cx="9" cy="12" r="6" fill-opacity="0.85" fill="#EB001B"/>
        <circle cx="15" cy="12" r="6" fill-opacity="0.85" fill="#F79E1B"/>
      </svg>
    </div>
  </div>
</div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
